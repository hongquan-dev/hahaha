{
  "info": {
    "name": "fd-auth-service",
    "description": "API sản phẩm của auth service (dữ liệu test). Validator: ProductValidator. Khi bị từ chối (400 REQUEST_VALIDATION_FAILED), lý do cụ thể nằm trong log ([VALIDATE] Rejected: ...).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "productId", "value": "1" }
  ],
  "item": [
    {
      "name": "Product - Create (không có tham số URL)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('productId', pm.response.json().data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/products",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "products"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Phở bò\",\n  \"category\": \"FOOD\",\n  \"price\": 45000\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "Body theo schemas/create-product.json: name (string, 1-100 ký tự, không trùng), category (FOOD/DRINK/DESSERT), price (number > 0, tối đa 2 chữ số thập phân). Tạo thành công thì productId của collection được gán bằng id vừa tạo."
      }
    },
    {
      "name": "Product - Create (category sai -> 400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/products",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "products"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Trà đá\",\n  \"category\": \"OTHER\",\n  \"price\": 5000\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "Bị từ chối với 400 REQUEST_VALIDATION_FAILED. Log: [VALIDATE] Rejected: category must be one of ..."
      }
    },
    {
      "name": "Product - Get by id (có tham số URL)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/auth/products/:productId",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "products", ":productId"],
          "variable": [
            { "key": "productId", "value": "{{productId}}", "description": "Số nguyên dương, phải tồn tại trong DB" }
          ]
        },
        "description": "Không có body. Id không phải số hoặc không tồn tại -> 400 REQUEST_VALIDATION_FAILED."
      }
    }
  ]
}
