{
  "info": {
    "name": "fd-auth-service",
    "description": "API của auth service. Đăng ký: AuthValidator kiểm tra định dạng (400 INVALID_REGISTER_INFO), AuthService kiểm tra trùng (409 USER_ALREADY_EXISTS); lỗi trả kèm errors theo từng field.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "registerUsername",
      "value": ""
    },
    {
      "key": "registerPhone",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{registerUsername}}\",\n  \"password\": \"MatKhau@123\",\n  \"email\": \"{{registerUsername}}@gmail.com\",\n  \"phoneNumber\": \"{{registerPhone}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Body theo schemas/register.json: username (3-30 ký tự a-z 0-9 . _), password (8-64 ký tự, có chữ hoa, chữ thường, chữ số, ký tự đặc biệt), email, phoneNumber (SĐT di động VN, nhận 0xxx / 84xxx / +84xxx). Pre-request script sinh username/SĐT ngẫu nhiên để chạy lại nhiều lần không bị trùng. 201 trả thông tin user, role luôn là CUSTOMER."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const n = Date.now().toString().slice(-8);",
              "pm.collectionVariables.set('registerUsername', 'user' + n);",
              "pm.collectionVariables.set('registerPhone', '09' + n);"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Register (trùng -> 409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{registerUsername}}\",\n  \"password\": \"MatKhau@123\",\n  \"email\": \"{{registerUsername}}@gmail.com\",\n  \"phoneNumber\": \"{{registerPhone}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Chạy sau 'Auth - Register': dùng lại username/email/SĐT vừa tạo -> 409 USER_ALREADY_EXISTS, errors liệt kê từng field bị trùng."
      }
    },
    {
      "name": "Auth - Register (sai định dạng -> 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"a b\",\n  \"password\": \"short\",\n  \"email\": \"abc\",\n  \"phoneNumber\": \"123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "400 INVALID_REGISTER_INFO, errors liệt kê lý do của từng field sai."
      }
    }
  ]
}
