{
  "info": {
    "name": "fd-order-service",
    "description": "API test của order service: lấy user đang đăng nhập từ auth-service qua HTTP và qua gRPC. Gọi qua API Gateway (baseUrl, 8080), gateway kiểm tra cookie access_token rồi gắn X-User-Id. Trước khi chạy: đặt biến identifier, password (một tài khoản đã đăng ký), bật auth-service (8081 + 9081), order-service (8083), gateway (8080). Chạy cả collection theo thứ tự; 3 request cuối gọi thẳng order (orderDirectUrl) để thấy order tự từ chối khi bị gọi bỏ qua gateway.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 + cookie access_token', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.cookies.has('access_token')).to.be.true;",
              "});",
              "pm.collectionVariables.set('userId', String(pm.response.json().data.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Đăng nhập qua gateway bằng tài khoản có sẵn (đặt biến identifier, password của collection trước khi chạy). Postman lưu cookie access_token và gửi kèm các request sau.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{identifier}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Order - Auth qua HTTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, transport HTTP, user là người vừa đăng nhập', () => {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json().data;",
              "  pm.expect(data.transport).to.eql('HTTP');",
              "  pm.expect(String(data.user.id)).to.eql(pm.collectionVariables.get('userId'));",
              "  pm.expect(data.user).to.have.all.keys('id', 'username', 'phoneNumber', 'role', 'active');",
              "  pm.collectionVariables.set('httpUser', JSON.stringify(data.user));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/order/test/auth-http",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "order",
            "test",
            "auth-http"
          ]
        },
        "description": "Gateway kiểm tra cookie access_token, gắn X-User-Id rồi chuyển sang order; order gọi GET /internal/users/{userId} của auth-service qua HTTP. elapsedMs là thời gian của riêng lời gọi sang auth."
      }
    },
    {
      "name": "Order - Auth qua gRPC",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, transport gRPC, cùng user với HTTP', () => {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json().data;",
              "  pm.expect(data.transport).to.eql('gRPC');",
              "  pm.expect(data.user).to.eql(JSON.parse(pm.collectionVariables.get('httpUser')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/order/test/auth-grpc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "order",
            "test",
            "auth-grpc"
          ]
        },
        "description": "Như request trên nhưng order gọi UserService/GetUser của auth-service qua gRPC (port 9081). user phải giống hệt kết quả qua HTTP."
      }
    },
    {
      "name": "Order - X-User-Id giả bị gateway thay",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Vẫn là user của token, không phải user giả', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(String(pm.response.json().data.user.id)).to.eql(pm.collectionVariables.get('userId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "17000000001000"
          },
          {
            "key": "X-User-Role",
            "value": "ADMIN"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/order/test/auth-grpc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "order",
            "test",
            "auth-grpc"
          ]
        },
        "description": "Gửi kèm X-User-Id của người khác: gateway xoá header client gửi lên và gắn lại từ token, nên order vẫn nhận user thật."
      }
    },
    {
      "name": "Auth - Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        },
        "description": "Kết thúc phiên; auth-service xoá 2 cookie."
      }
    },
    {
      "name": "Order - Sau logout -> 401 (gateway)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 UNAUTHENTICATED từ gateway', () => {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().code).to.eql('UNAUTHENTICATED');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/order/test/auth-grpc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "order",
            "test",
            "auth-grpc"
          ]
        },
        "description": "Không còn cookie access_token: gateway trả 401, request không tới order."
      }
    },
    {
      "name": "Order trực tiếp - Không có X-User-Id -> 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 UNAUTHENTICATED từ AuthTestValidator', () => {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().code).to.eql('UNAUTHENTICATED');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{orderDirectUrl}}/order/test/auth-http",
          "host": [
            "{{orderDirectUrl}}"
          ],
          "path": [
            "order",
            "test",
            "auth-http"
          ]
        },
        "description": "Gọi thẳng order (orderDirectUrl, 8083), bỏ qua gateway: không có X-User-Id nên validator của order từ chối. Chỉ làm được trong mạng nội bộ."
      }
    },
    {
      "name": "Order trực tiếp - User không tồn tại -> 404 (gRPC)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 USER_NOT_FOUND, mã lỗi lấy từ trailer gRPC', () => {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.json().code).to.eql('USER_NOT_FOUND');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "17000000001000"
          }
        ],
        "url": {
          "raw": "{{orderDirectUrl}}/order/test/auth-grpc",
          "host": [
            "{{orderDirectUrl}}"
          ],
          "path": [
            "order",
            "test",
            "auth-grpc"
          ]
        },
        "description": "X-User-Id hợp lệ nhưng không có user: auth trả NOT_FOUND kèm trailer error-code, order chuyển thành 404 USER_NOT_FOUND như API HTTP."
      }
    },
    {
      "name": "Order trực tiếp - User không tồn tại -> 404 (HTTP)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 USER_NOT_FOUND, giống hệt bản gRPC', () => {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.json().code).to.eql('USER_NOT_FOUND');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "17000000001000"
          }
        ],
        "url": {
          "raw": "{{orderDirectUrl}}/order/test/auth-http",
          "host": [
            "{{orderDirectUrl}}"
          ],
          "path": [
            "order",
            "test",
            "auth-http"
          ]
        },
        "description": "Như request trên nhưng qua HTTP: cùng status, cùng mã lỗi."
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "orderDirectUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "identifier",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "httpUser",
      "value": ""
    }
  ]
}
