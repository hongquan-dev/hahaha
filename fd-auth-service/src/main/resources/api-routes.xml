<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- Registration: schema checks structure, validator values (no DB), AuthService duplicate accounts -->
    <route>
        <method>POST</method>
        <path>/auth/register</path>
        <schema>schemas/register.json</schema>
        <validator>com.fooddelivery.auth.validation.AuthValidator.validateRegister</validator>
        <controller>com.fooddelivery.auth.controller.AuthController</controller>
    </route>

    <!-- Login, sets both cookies: schema checks structure, validator presence and length, AuthService the account -->
    <route>
        <method>POST</method>
        <path>/auth/login</path>
        <schema>schemas/login.json</schema>
        <validator>com.fooddelivery.auth.validation.AuthValidator.validateLogin</validator>
        <controller>com.fooddelivery.auth.controller.AuthController</controller>
    </route>

    <!-- Current user of the access_token cookie; no body, AuthService checks the token -->
    <route>
        <method>GET</method>
        <path>/auth/me</path>
        <controller>com.fooddelivery.auth.controller.AuthController</controller>
    </route>

    <!-- Renews both cookies from the refresh_token cookie (rotation); no body, SessionService checks the token -->
    <route>
        <method>POST</method>
        <path>/auth/refresh</path>
        <controller>com.fooddelivery.auth.controller.AuthController</controller>
    </route>

    <!-- Ends the session of the refresh_token cookie and clears both cookies; no body -->
    <route>
        <method>POST</method>
        <path>/auth/logout</path>
        <controller>com.fooddelivery.auth.controller.AuthController</controller>
    </route>

    <!-- Internal user for other services, no gateway route: validator checks the ID, UserQueryService it exists -->
    <route>
        <method>GET</method>
        <path>/internal/users/{userId}</path>
        <validator>com.fooddelivery.auth.validation.InternalUserValidator.validateGetUser</validator>
        <controller>com.fooddelivery.auth.controller.InternalUserController</controller>
    </route>

    <!-- Test API: owner and lifetime of the access_token cookie; no body, PingService checks the token -->
    <route>
        <method>GET</method>
        <path>/auth/test/ping</path>
        <controller>com.fooddelivery.auth.controller.TestController</controller>
    </route>
</routes>
