<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- Registration. The schema checks the body structure, the validator checks required fields and format
         (no database query); duplicate username/email/phone number are checked by AuthService -->
    <route>
        <method>POST</method>
        <path>/auth/register</path>
        <schema>schemas/register.json</schema>
        <validator>com.fooddelivery.auth.validation.AuthValidator.validateRegister</validator>
        <controller>com.fooddelivery.auth.controller.AuthController</controller>
    </route>
</routes>
