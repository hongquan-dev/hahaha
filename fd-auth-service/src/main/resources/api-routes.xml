<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- API test: có schema và validator -->
    <route>
        <method>POST</method>
        <path>/auth/test/items</path>
        <schema>schemas/test-item.json</schema>
        <validator>com.fooddelivery.auth.validation.TestValidator.validateItem</validator>
        <controller>TestController</controller>
    </route>

    <!-- ===== API test trả lỗi bằng ResponseHandler.generateErrorResponse ===== -->

    <!-- Cùng method trả thành công (200) hoặc lỗi (404) -->
    <route>
        <method>GET</method>
        <path>/auth/test/errors/orders/{id}</path>
        <schema></schema>
        <validator></validator>
        <controller>TestController</controller>
    </route>

    <!-- Chỉ truyền status -->
    <route>
        <method>GET</method>
        <path>/auth/test/errors/status-only</path>
        <schema></schema>
        <validator></validator>
        <controller>TestController</controller>
    </route>

    <!-- 400 lỗi chung -->
    <route>
        <method>GET</method>
        <path>/auth/test/errors/bad-request</path>
        <schema></schema>
        <validator></validator>
        <controller>TestController</controller>
    </route>

    <!-- 400 kèm lỗi theo field -->
    <route>
        <method>GET</method>
        <path>/auth/test/errors/validation</path>
        <schema></schema>
        <validator></validator>
        <controller>TestController</controller>
    </route>

    <!-- Chỉ truyền status + lỗi theo field, message mặc định -->
    <route>
        <method>GET</method>
        <path>/auth/test/errors/field-errors</path>
        <schema></schema>
        <validator></validator>
        <controller>TestController</controller>
    </route>

    <!-- 401 -->
    <route>
        <method>GET</method>
        <path>/auth/test/errors/unauthorized</path>
        <schema></schema>
        <validator></validator>
        <controller>TestController</controller>
    </route>

    <!-- 403 -->
    <route>
        <method>GET</method>
        <path>/auth/test/errors/forbidden</path>
        <schema></schema>
        <validator></validator>
        <controller>TestController</controller>
    </route>

    <!-- 409 -->
    <route>
        <method>GET</method>
        <path>/auth/test/errors/conflict</path>
        <schema></schema>
        <validator></validator>
        <controller>TestController</controller>
    </route>

    <!-- 429 kèm header Retry-After -->
    <route>
        <method>GET</method>
        <path>/auth/test/errors/too-many-requests</path>
        <schema></schema>
        <validator></validator>
        <controller>TestController</controller>
    </route>

    <!-- 500, message mặc định -->
    <route>
        <method>GET</method>
        <path>/auth/test/errors/internal</path>
        <schema></schema>
        <validator></validator>
        <controller>TestController</controller>
    </route>

    <!-- 503 -->
    <route>
        <method>GET</method>
        <path>/auth/test/errors/unavailable</path>
        <schema></schema>
        <validator></validator>
        <controller>TestController</controller>
    </route>

    <!-- Dùng sai: generateErrorResponse với status 200 -->
    <route>
        <method>GET</method>
        <path>/auth/test/errors/misuse/error-with-200</path>
        <schema></schema>
        <validator></validator>
        <controller>TestController</controller>
    </route>

    <!-- Dùng sai: generateResponse với status 404 -->
    <route>
        <method>GET</method>
        <path>/auth/test/errors/misuse/success-with-404</path>
        <schema></schema>
        <validator></validator>
        <controller>TestController</controller>
    </route>
</routes>
