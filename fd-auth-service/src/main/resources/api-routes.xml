<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- API test: validator lấy thông tin từ path variable, query param, header và body -->
    <route>
        <method>POST</method>
        <path>/auth/test/users/{userId}/items</path>
        <schema>schemas/test-item.json</schema>
        <validator>com.fooddelivery.auth.validation.TestValidator.validateItem</validator>
        <controller>TestController</controller>
    </route>
</routes>
