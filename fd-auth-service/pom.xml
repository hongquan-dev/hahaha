<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fooddelivery</groupId>
        <artifactId>food-delivery-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>fd-auth-service</artifactId>
    <name>food-delivery-auth-service</name>
    <description>Auth Management Service</description>

    <dependencies>
        <!-- Web, API flow, Log4j2, JPA, PostgreSQL, Flyway (database FD_auth_db); version from the parent pom -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-lib</artifactId>
        </dependency>

        <!-- BCryptPasswordEncoder only, without Spring Security's filter chain -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Signs the RS256 access tokens and builds the JWKS; same version as the gateway, which verifies them -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus-jose-jwt.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Executable jar for java -jar: all dependencies inside, Main-Class set -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
