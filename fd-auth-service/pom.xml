<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fooddelivery</groupId>
        <artifactId>food-delivery-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>fd-auth-service</artifactId>
    <name>food-delivery-auth-service</name>
    <description>Auth Management Service</description>

    <dependencies>
        <!-- Every runtime library, e.g. spring-security-crypto, nimbus-jose-jwt, Flyway, comes from common-lib; the
             test libraries come from the parent pom -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-lib</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- gRPC server (UserGrpcService): a Netty server of its own on spring.grpc.server.port, next to Tomcat. Its
             Logback starter is excluded: the services log with Log4j2 and both on the classpath fail at the first
             logger -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-grpc-server</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Generated classes of the .proto contracts, e.g. UserServiceGrpc -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>fd-grpc-api</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Server reflection, so grpcurl or Postman can list and call the services without the .proto files;
             switched by spring.grpc.server.reflection.enabled -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-services</artifactId>
        </dependency>

        <!-- In-memory gRPC server and channel for UserGrpcServiceTest: real stubs and status codes, no port -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>