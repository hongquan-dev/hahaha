{
  "info": {
    "name": "Service Auth - Register",
    "description": "Test API đăng ký POST /auth/register (service-auth)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" }
  ],
  "item": [
    {
      "name": "1. Register - Success (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Has 14-digit id', () => pm.expect(String(body.id)).to.match(/^\\d{14}$/));",
              "pm.test('Role is CUSTOMER', () => pm.expect(body.role).to.eql('CUSTOMER'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"quan_nguyen\",\n  \"password\": \"secret123\",\n  \"email\": \"quan@example.com\",\n  \"phoneNumber\": \"0912345678\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "2. Register - Username taken (400, validator)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"secret123\",\n  \"email\": \"admin@example.com\",\n  \"phoneNumber\": \"0912345678\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "3. Register - Password equals username (400, validator)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"quan123\",\n  \"password\": \"quan123\",\n  \"email\": \"quan@example.com\",\n  \"phoneNumber\": \"0912345678\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "4. Register - Wrong type / unknown field (400, schema)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              "pm.test('Generic error message', () => pm.expect(pm.response.json().error).to.eql('Invalid request body!'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": 123,\n  \"password\": \"secret123\",\n  \"email\": \"quan@example.com\",\n  \"phoneNumber\": \"0912345678\",\n  \"age\": 20\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "5. Register - Missing fields (400, schema)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"quan_nguyen\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    }
  ]
}
