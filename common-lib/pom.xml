<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fooddelivery</groupId>
        <artifactId>food-delivery-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>common-lib</artifactId>
    <name>common-lib</name>
    <description>Dependency bundle of the Spring MVC services (web, API flow, Log4j2, JPA, PostgreSQL, Flyway); no code
    </description>

    <dependencies>
        <!-- Spring MVC; Logback excluded for Log4j2 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!-- Every service using common-lib owns a PostgreSQL database; one without a database must not use it -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Jackson 3 XML, the default Jackson of Spring Boot 4 -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>

        <!-- 14-digit IDs: IdUtils, EntityType -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-id-lib</artifactId>
            <version>${food-delivery-libs.version}</version>
        </dependency>

        <!-- Plain models: ApiResponse, ApiStatus, FieldErrorDetail, PageMeta -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-dto-lib</artifactId>
            <version>${food-delivery-libs.version}</version>
        </dependency>

        <!-- ResponseHandler, BusinessException, GlobalExceptionHandler -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-web-lib</artifactId>
            <version>${food-delivery-libs.version}</version>
        </dependency>

        <!-- API flow: api-routes.xml allow list, JSON Schema, validators -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-api-flow-lib</artifactId>
            <version>${food-delivery-libs.version}</version>
        </dependency>

        <!-- Flyway migrations at startup; Spring Boot 4 needs the starter, PostgreSQL support is a separate module -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
    </dependencies>
</project>
