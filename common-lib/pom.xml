<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fooddelivery</groupId>
        <artifactId>food-delivery-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>common-lib</artifactId>
    <name>common-lib</name>
    <description>Shared DTOs, Exceptions, and Utilities</description>

    <properties>
<!--        <food-delivery-libs.version>1.0.0</food-delivery-libs.version>-->
        <food-delivery-libs.version>1.0.0-SNAPSHOT</food-delivery-libs.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Jackson 3, the default of Spring Boot 4 -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>

        <!-- IDs: generates and decodes 14-digit IDs (IdUtils, EntityType) -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-id-lib</artifactId>
            <version>${food-delivery-libs.version}</version>
        </dependency>

        <!-- Plain models: ApiResponse, ApiStatus, FieldErrorDetail, PageMeta, shared enums and DTOs -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-dto-lib</artifactId>
            <version>${food-delivery-libs.version}</version>
        </dependency>

        <!-- Web: ResponseHandler, ApiResponseWriter, BusinessException, GlobalExceptionHandler -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-web-lib</artifactId>
            <version>${food-delivery-libs.version}</version>
        </dependency>

        <!-- API flow: route allow list (api-routes.xml), JSON Schema check, validator call. Every service needs an api-routes.xml -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-api-flow-lib</artifactId>
            <version>${food-delivery-libs.version}</version>
        </dependency>

        <!-- BCryptPasswordEncoder only, without Spring Security's filter chain -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Signs and verifies the RS256 access tokens and builds the JWKS other services use to verify them.
             Not managed by the Spring Boot BOM, hence the explicit version -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>10.10</version>
        </dependency>

        <!-- Database migrations: runs the SQL files in src/main/resources/db/migration of each service at startup,
             before Hibernate. Only active in a service with a DataSource; a service without that folder only gets a
             warning. Since Spring Boot 4 the auto-configuration is in its own starter: flyway-core alone would never
             run the migrations. PostgreSQL support is a separate Flyway module. Versions come from the Spring Boot
             BOM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>
</project>