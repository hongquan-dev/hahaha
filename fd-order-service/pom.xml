<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fooddelivery</groupId>
        <artifactId>food-delivery-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>fd-order-service</artifactId>
    <name>food-delivery-order-service</name>
    <description>Order Management Service</description>

    <dependencies>
        <!-- Web, API flow, Log4j2, JPA, PostgreSQL, Flyway (database FD_order_db); version from the parent pom -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-lib</artifactId>
        </dependency>

        <!-- Generated classes of the .proto contracts, e.g. UserServiceGrpc.UserServiceBlockingStub -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>fd-grpc-api</artifactId>
        </dependency>

        <!-- gRPC client: channels and @ImportGrpcClients stubs; version and Logback exclusion from the parent -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-grpc-client</artifactId>
        </dependency>

        <!-- In-memory gRPC server and channel for AuthGrpcClientTest -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Executable jar for java -jar: all dependencies inside, Main-Class set -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
