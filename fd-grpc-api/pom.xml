<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fooddelivery</groupId>
        <artifactId>food-delivery-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>fd-grpc-api</artifactId>
    <name>food-delivery-grpc-api</name>
    <description>gRPC contracts (.proto) shared by the services, with the generated Java code, and the gRPC support
        every service gets automatically: error handling and logging on the server side, caller header on the client
        side</description>

    <dependencies>
        <!-- Runtime of the generated code: messages (grpc-protobuf) and stubs (grpc-stub); versions from the BOM -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>

        <!-- Needed by package support; optional, as a gRPC service already has them via its starter and common-lib -->
        <dependency>
            <groupId>org.springframework.grpc</groupId>
            <artifactId>spring-grpc-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-web-lib</artifactId>
            <version>${food-delivery-libs.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Tests: in-process server and channel, and Spring Boot's gRPC auto-configurations without a real server -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-grpc-server</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-grpc-client</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Tests: a real ThreadContext for the request ID; with log4j-api alone it keeps nothing -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Generates messages, service bases and stubs from src/main/proto, and the test-only src/test/proto -->
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <configuration>
                    <!-- No contract in src/main/proto is valid: it holds only the ones the services use (default true) -->
                    <failOnMissingSources>false</failOnMissingSources>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-test</id>
                        <goals>
                            <goal>generate-test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Test jar with InProcessGrpcServer only, for the gRPC tests of the services (type test-jar) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>com/fooddelivery/grpc/testing/InProcessGrpcServer.class</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
