<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fooddelivery</groupId>
        <artifactId>food-delivery-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>fd-grpc-api</artifactId>
    <name>food-delivery-grpc-api</name>
    <description>gRPC contracts (.proto) shared by the services, with the generated Java code, and the gRPC support
        every service gets automatically: error handling and logging on the server side, caller header on the client
        side</description>

    <dependencies>
        <!-- Runtime of the generated code: messages (protobuf-java, through grpc-protobuf) and stubs (grpc-stub).
             Versions come from the Spring Boot BOM, the same as the gRPC starters of the services -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>

        <!-- The gRPC support (package support) and its auto-configuration. Optional: a service using it already has
             them, through spring-boot-starter-grpc-server/-client (Spring gRPC) and common-lib (BusinessException,
             Log4j2, auto-configuration), so this module does not force them on anyone -->
        <dependency>
            <groupId>org.springframework.grpc</groupId>
            <artifactId>spring-grpc-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-web-lib</artifactId>
            <version>${food-delivery-libs.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Tests: in-process gRPC server and channel; the auto-configuration test also needs the server and client
             auto-configurations of Spring Boot, without starting a real server -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-grpc-server</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-grpc-client</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Generates Java classes from src/main/proto at each build: messages and, through protoc-gen-grpc-java,
                 the service base class (server) and stubs (client). protoc and plugin versions and the generate goal
                 are configured by spring-boot-starter-parent -->
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
