<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <!-- Log interface -->
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss} [${spring:spring.application.name}] %-5level %logger{36} - %msg%n</Property>
    </Properties>

    <Appenders>
        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>
    </Appenders>

    <Loggers>
        <!-- Root level: DEBUG -> Project -->
        <Logger name="com.fooddelivery" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Root level: INFO -> Spring boot -->
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>