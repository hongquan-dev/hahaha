<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fooddelivery</groupId>
        <artifactId>food-delivery-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>fd-gateway-service</artifactId>
    <name>food-delivery-gateway-service</name>
    <description>Spring Cloud Gateway</description>

    <dependencies>
        <!-- Spring Cloud Gateway on WebFlux (reactive), which it already includes. Routes are configured under
             spring.cloud.gateway.server.webflux.* -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>

        <!-- Log4j2, so the gateway logs like the other services -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!-- Verifies the RS256 access tokens with the public key published by auth-service (JWKS). Same library and
             version as auth-service, which signs them -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus-jose-jwt.version}</version>
        </dependency>

        <!-- ApiResponse and ApiStatus, so the gateway's 401/503 bodies look like the services' errors. Not common-lib:
             it brings Spring MVC, and the gateway runs on WebFlux -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-dto-lib</artifactId>
            <version>${food-delivery-libs.version}</version>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>
</project>