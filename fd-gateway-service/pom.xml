<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fooddelivery</groupId>
        <artifactId>food-delivery-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>fd-gateway-service</artifactId>
    <name>food-delivery-gateway-service</name>
    <description>Spring Cloud Gateway</description>

    <dependencies>
        <!-- Spring Cloud Gateway on WebFlux; routes under spring.cloud.gateway.server.webflux.* -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>

        <!-- Log4j2, so the gateway logs like the other services -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!-- Verifies the RS256 access tokens with auth-service's JWKS; same version as auth, which signs them -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus-jose-jwt.version}</version>
        </dependency>

        <!-- ApiResponse for the gateway's own errors; not common-lib, which brings Spring MVC into this WebFlux app -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-dto-lib</artifactId>
            <version>${food-delivery-libs.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Executable jar for java -jar: all dependencies inside, Main-Class set -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
